# ---- Claude API ----
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ---- Email sending (Gmail SMTP) ----
# Enable 2-Step Verification on this Gmail account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and paste it below (not your normal password).
EMAIL_SERVICE=gmail
EMAIL_USER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ---- WhatsApp ----
# The bot logs into its OWN WhatsApp account (see README - you need a spare/second
# number for this, not your main one) by scanning a QR code on first run.
# WHATSAPP_OWNER_NUMBER is YOUR personal number (the one you'll message the bot FROM),
# so the bot ignores messages from anyone else. Country code, digits only, no "+", no spaces.
# Example: Zimbabwe number +263 77 123 4567 -> 263771234567
WHATSAPP_OWNER_NUMBER=2637xxxxxxxx

# ---- Behaviour ----
SCRAPE_INTERVAL_MINUTES=60
MATCH_THRESHOLD=7
MAX_PAGES_PER_SOURCE=2
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PersonalJobBot/1.0)

# ---- Local paths (leave unset to use ./data locally, or /data on Render) ----
# DATA_DIR=./data

# ---- Only needed for deploying to Render (see README) ----
# Base64-encoded contents of your data/profile.md and data/cv_template.md,
# so they can be securely uploaded as env vars instead of committed to git.
# PROFILE_MD_BASE64=
# CV_TEMPLATE_MD_BASE64=
