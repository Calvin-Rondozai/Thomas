# ---- Gemini API ----
# Get a key at https://aistudio.google.com/apikey (this is separate from a Gemini/
# Google One subscription - it is pay-as-you-go API billing, with a usable free tier).
# You can list more than one key, comma-separated - the bot automatically rotates to
# the next one if a key hits its quota, and only messages you on WhatsApp once every
# key in the list is exhausted. Note: rotation only helps if keys belong to *different*
# Google Cloud projects/accounts - keys on the same project share one quota bucket.
GEMINI_API_KEYS=your-key-here,optional-second-key,optional-third-key

# ---- Email sending (Gmail API via OAuth - not SMTP) ----
# This sends as your real Gmail address over HTTPS, so it works even on hosts that
# block outbound SMTP ports (like Render's free tier). See README.md for the Google
# Cloud Console setup, then run `node scripts/get-gmail-token.js` once locally to get
# GMAIL_REFRESH_TOKEN.
EMAIL_USER=you@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Upstash Redis (free, no card) ----
# This is where the bot persists everything (WhatsApp login session + job database),
# since Render's free tier wipes local disk on every restart. Create a free database at
# https://console.upstash.com/ and copy its REST URL + token from the database's page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- WhatsApp ----
# The bot logs into its OWN WhatsApp account (see README - you need a spare/second
# number for this, not your main one) by scanning a QR code on first run.
# WHATSAPP_OWNER_NUMBER is YOUR personal number (the one you'll message the bot FROM),
# so the bot ignores messages from anyone else. Country code, digits only, no "+", no spaces.
# Example: Zimbabwe number +263 77 123 4567 -> 263771234567
WHATSAPP_OWNER_NUMBER=2637xxxxxxxx

# ---- Behaviour ----
SCRAPE_INTERVAL_MINUTES=60
MATCH_THRESHOLD=7
MAX_PAGES_PER_SOURCE=2
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; PersonalJobBot/1.0)

# ---- Local paths ----
# DATA_DIR=./data

# ---- Only needed for deploying to Render (see README) ----
# Base64-encoded contents of your data/profile.md and data/cv_template.md, rewritten
# to local disk on every boot (local disk is ephemeral on Render's free tier).
# PROFILE_MD_BASE64=
# CV_TEMPLATE_MD_BASE64=

# Render sets this automatically in production - only set it locally if port 3000 is
# already in use on your machine.
# PORT=3000
